# =========================================
# CONFIGURAZIONE EXCHANGE - BITGET
# =========================================
BITGET_API_KEY=INSERISCI_QUI_LA_TUA_API_KEY
BITGET_SECRET_KEY=INSERISCI_QUI_LA_TUA_SECRET_KEY
BITGET_PASSPHRASE=INSERISCI_QUI_LA_TUA_PASSPHRASE
EXCHANGE=bitget

# =========================================
# SIMBOLI E TIMEFRAME
# =========================================
# Elenco separato da virgole. Se lasciato vuoto vengono usati
# i simboli definiti in rules.json.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=1h

# =========================================
# PARAMETRI DI RISCHIO
# =========================================
PORTFOLIO_VALUE_USD=1000
MAX_TRADE_SIZE_USD=50
# Attenzione: un tetto basso riduce il rischio reale sotto la percentuale
# dichiarata in rules.json. Il bot lo segnala nei log a ogni trade limitato.
MAX_TRADES_PER_DAY_PER_SYMBOL=3
MAX_TRADES_PER_DAY_TOTAL=0
MAX_POSITIONS_PER_SYMBOL=1
# 0 = calcolato automaticamente come (numero simboli x posizioni per simbolo)
MAX_POSITIONS=0
MAX_DRAWDOWN_PERCENT=20
MIN_NOTIONAL_USD=5

# =========================================
# MODALITA' DI TRADING
# =========================================
# PAPER_TRADING deve valere esattamente "false" per operare con denaro reale.
# Qualunque altro valore (o assenza) mantiene la simulazione.
PAPER_TRADING=true
# spot = solo posizioni long. I segnali SHORT vengono rifiutati:
# sullo spot non si puo' vendere allo scoperto.
TRADE_MODE=spot
LEVERAGE=1

# =========================================
# SORGENTE DATI
# =========================================
# bitget    = candele reali dall'exchange
# synthetic = dati finti per test offline (rifiutato in modalita' live)
DATA_SOURCE=bitget

# =========================================
# CICLO
# =========================================
CYCLE_INTERVAL_MS=60000

# =========================================
# MCP (opzionale, TradingView)
# =========================================
MCP_SERVER_PORT=9222
MCP_HOST=localhost

# =========================================
# WEBHOOK
# =========================================
WEBHOOK_ENABLED=true
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook
# OBBLIGATORIO in modalita' live: senza token il webhook non viene avviato.
# Chi invia la richiesta deve includere l'header X-Webhook-Token.
WEBHOOK_TOKEN=

# =========================================
# LOGGING E STATO
# =========================================
LOG_LEVEL=info
LOG_FILE=bot.log
TRADES_FILE=trades.csv
SAFETY_LOG_FILE=safety-check-log.json
STATE_FILE=bot-state.json
POSITIONS_FILE=positions.json
